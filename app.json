{
  "expo": {
    "name": "Revival : Mon Quotidien",
    "slug": "mon-quotidien",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1C1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.revivalculture.monquotidien",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Mon Quotidien",
        "NSCameraUsageDescription": "This app uses the camera to scan for...",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A1C1E"
      },
      "package": "com.revivalculture.monquotidien",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mon Quotidien",
      "shortName": "Mon Quotidien",
      "lang": "fr",
      "themeColor": "#1A1C1E",
      "backgroundColor": "#1A1C1E",
      "display": "standalone",
      "startUrl": "/",
      "description": "Application de méditation quotidienne",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-router",
          {
            "origin": "https://revculture.ci" 
          }
      ],
      "expo-localization",
      "expo-font",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "486f80bd-312d-433f-aa93-e433de4ece38"
      }
    }
  }
}
